# Supabase → Project Settings → API (or the "Connect" dialog).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). A legacy "anon" key also works.
# It's safe in client code; never put the secret/service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
